# SQLite is the MVP default.  For PostgreSQL later, change to e.g.
# postgresql+psycopg://user:password@localhost/frequency
DATABASE_URL=sqlite:///./frequency.db
# Valor inicial para embeddings SFace/OpenCV. Calibre com dados consentidos antes de uso real.
FACE_MATCH_THRESHOLD=0.45
RECOGNITION_COOLDOWN_SECONDS=15

# Cliente de visao (camera e API no mesmo computador por padrao)
FREQUENCY_API_URL=http://127.0.0.1:8000
VISION_CLASS_ID=1
VISION_CAMERA_ID=usb-entrada-01
